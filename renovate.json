{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>diggsweden/.github:renovate-base", ":maintainLockFilesWeekly"],
  "enabledManagers": ["github-actions", "npm", "mise", "dockerfile"],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Automerge endast patch",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Node.js dependencies - Major updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["dependencies", "major-update"]
    },
    {
      "description": "Development dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies",
      "addLabels": ["dev-deps"],
      "matchPackageNames": ["!@stoplight/spectral-formats"]
    },
    {
      "description": "Core dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "groupName": "core dependencies",
      "addLabels": ["core-deps"],
      "matchPackageNames": ["!/^@stoplight/spectral/"]
    },
    {
      "description": "Spectral dependencies",
      "groupName": "spectral",
      "labels": ["spectral"],
      "matchPackageNames": ["/^@stoplight/spectral/"]
    },
    {
      "description": "Node.js engine",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "enabled": true,
      "rangeStrategy": "replace",
      "labels": ["node-engine"]
    },
    {
      "description": "Docker base images",
      "matchManagers": ["dockerfile"],
      "addLabels": ["docker", "infrastructure"]
    },
    {
      "description": "Mise tools - Major updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["tools", "major-update"],
      "groupName": "mise major"
    },
    {
      "description": "Mise tools - Non-major updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["tools"],
      "groupName": "mise non-major"
    },
    {
      "description": "Security and compliance tools",
      "matchManagers": ["mise"],
      "matchPackageNames": ["aqua:zricethezav/gitleaks", "aqua:siderolabs/conform", "aqua:rhysd/actionlint"],
      "addLabels": ["security-tools"],
      "groupName": "security tools"
    },
    {
      "description": "Documentation and build tools",
      "matchManagers": ["mise"],
      "matchPackageNames": [
        "aqua:google/yamlfmt",
        "aqua:rvben/rumdl",
        "github:italia/publiccode-parser-go",
        "aqua:casey/just"
      ],
      "addLabels": ["documentation"],
      "groupName": "documentation tools"
    }
  ]
}
