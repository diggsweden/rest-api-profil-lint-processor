{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>diggsweden/.github:renovate-base", ":maintainLockFilesWeekly"],
  "enabledManagers": ["github-actions", "npm"],
  "platformAutomerge": false,
  "automergeSchedule": ["0 9-21 * * 6"],
  "packageRules": [
    {
      "description": "Automerge endast patch",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Node.js dependencies - Major updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["dependencies", "major-update"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Development dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies",
      "addLabels": ["dev-deps"],
      "matchPackageNames": ["!@stoplight/spectral-formats"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Core dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "groupName": "core dependencies",
      "addLabels": ["core-deps"],
      "matchPackageNames": ["!/^@stoplight/spectral/"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Spectral dependencies",
      "groupName": "spectral",
      "labels": ["spectral"],
      "matchPackageNames": ["/^@stoplight/spectral/"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Node.js engine",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "enabled": true,
      "rangeStrategy": "replace",
      "labels": ["node-engine"],
      "minimumReleaseAge": "7 days"
    }
  ]
}
